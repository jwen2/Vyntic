# Vyntic — Configuration
# Get your free API key at https://aistudio.google.com

# Google Gemini AI Studio
GEMINI_API_KEY=your_api_key_here

# LLM Models (defaults shown — override to change)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Embeddings
# EMBEDDING_MODEL=models/gemini-embedding-001

# ChromaDB (local vector store)
# CHROMA_PERSIST_DIR=/app/data/chroma

# Agentic features (beta) — enables Investigate diligence agent + suggested columns.
# Backend: set AGENTIC_FEATURES=true to mount the new routes.
# Frontend (Next.js build time): set NEXT_PUBLIC_AGENTIC=1 to render the new UI.
# AGENTIC_FEATURES=false
# NEXT_PUBLIC_AGENTIC=0
