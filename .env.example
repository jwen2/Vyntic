# Vyntic — Configuration
# Get your free API key at https://aistudio.google.com

# Google Gemini AI Studio
GEMINI_API_KEY=your_api_key_here

# Service secrets
JWT_SECRET_KEY=CHANGE-ME-in-production-use-a-real-secret

# Dev-only opt-in to boot with the default secrets above.
# Production must NEVER set this — without it the app refuses to start
# on default JWT_SECRET_KEY / DEFAULT_ADMIN_PASSWORD values.
ALLOW_INSECURE_DEFAULTS=true

# LLM Models (defaults shown — override to change)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Embeddings
# EMBEDDING_MODEL=models/gemini-embedding-001

# ChromaDB (local vector store)
# CHROMA_PERSIST_DIR=/app/data/chroma

# Large PDF ingestion
# DOCLING_PAGE_BATCH_SIZE=10
# DOCLING_QUEUE_MAX_SIZE=2
# DOCLING_MAX_CONCURRENT_JOBS=1
# INGEST_BACKGROUND_MIN_PAGES=25
# EMBEDDING_BATCH_SIZE=64

# Chunking
# CHUNK_SIZE=1000
# CHUNK_OVERLAP_RATIO=0.2

# Agentic features (beta) — enables Investigate diligence agent + suggested columns.
# Backend: set AGENTIC_FEATURES=true to mount the new routes.
# Frontend (Next.js build time): set NEXT_PUBLIC_AGENTIC=1 to render the new UI.
# AGENTIC_FEATURES=false
# NEXT_PUBLIC_AGENTIC=0
