{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Only index.tokens.test.ts needs Node builtins (fs/path/url) to read
    // index.css from disk. There's no narrower scope without a second
    // tsconfig for tests (over-engineering at this project's size), so this
    // is a documented, intentional exposure rather than an implicit side
    // effect of installing @types/node — it also forecloses some other
    // @types/* package silently doing the same later unnoticed.
    "types": ["node"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
